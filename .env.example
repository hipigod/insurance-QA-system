# ====================================
# 保险销售智能陪练系统 - 环境变量配置
# ====================================
# 复制此文件为 .env 并填入实际的配置值

# ====================================
# 大模型配置说明（重要变更）
# ====================================
# 大模型不再通过环境变量配置！
# 启动系统后进入「管理后台 → 模型管理」添加模型，
# 配置自动保存到服务端 data/model_config.json，
# 可添加多个模型，开始对话练习时自由选择。

# ====================================
# 对话配置（可选）
# ====================================
# AI响应超时时间（秒）
AI_RESPONSE_TIMEOUT=25

# AI创意度（0-1，越高越随机）
AI_TEMPERATURE=0.7

# 最大对话轮次
MAX_DIALOGUE_ROUNDS=20

# ====================================
# 应用配置（通常不需要修改）
# ====================================
# 应用名称
APP_NAME=保险销售智能陪练系统

# 应用版本
APP_VERSION=1.2.0

# 调试模式（生产环境建议设为False）
DEBUG=False

# 服务器配置
HOST=0.0.0.0
PORT=8000

# ====================================
# 部署说明
# ====================================
# 1. 首次部署请复制此文件：
#    cp .env.example .env
#
# 2. 启动服务：
#    docker-compose up -d
#
# 3. 打开系统，进入「管理后台 → 模型管理」添加大模型配置
#
# 4. 查看日志：
#    docker-compose logs -f
